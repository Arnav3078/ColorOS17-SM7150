#!/sbin/sh
# ==============================================================================
# Dynamic Partition Installer for ColorOS 17 (Samsung Galaxy M51 / SM7150)
# ==============================================================================

OUTFD=$2
ZIPFILE=$3

ui_print() {
    echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

ui_print "*****************************************************"
ui_print "*   ColorOS 17 Flagship Port for Galaxy M51 (sm7150)  *"
ui_print "*   Parallel Processing Animations & Zero-Lag Engine  *"
ui_print "*****************************************************"

# Verify device
DEVICE=$(getprop ro.product.device)
MODEL=$(getprop ro.product.model)
ui_print "- Current device: $DEVICE ($MODEL)"

ui_print "- Extracting ROM components to storage..."
WORKDIR="/data/local/tmp/coloros_install"
mkdir -p "$WORKDIR" 2>/dev/null || WORKDIR="/sdcard/coloros_install"
mkdir -p "$WORKDIR" 2>/dev/null || WORKDIR="/tmp/coloros_install"
mkdir -p "$WORKDIR"

# Flashing boot
ui_print "- Extracting & Flashing Boot Image (Kernel & KSU)..."
unzip -o "$ZIPFILE" boot.img -d "$WORKDIR" >/dev/null 2>&1 || true
if [ -f "$WORKDIR/boot.img" ]; then
    dd if="$WORKDIR/boot.img" of=/dev/block/bootdevice/by-name/boot bs=4M
    rm -f "$WORKDIR/boot.img"
fi

# Flashing dtbo
ui_print "- Extracting & Flashing Device Tree Overlay (DTBO)..."
unzip -o "$ZIPFILE" dtbo.img -d "$WORKDIR" >/dev/null 2>&1 || true
if [ -f "$WORKDIR/dtbo.img" ]; then
    dd if="$WORKDIR/dtbo.img" of=/dev/block/bootdevice/by-name/dtbo bs=4M
    rm -f "$WORKDIR/dtbo.img"
fi

# Flashing vbmeta (AVB disabled)
ui_print "- Extracting & Flashing AVB-Disabled VBMETA..."
unzip -o "$ZIPFILE" vbmeta.img -d "$WORKDIR" >/dev/null 2>&1 || true
if [ -f "$WORKDIR/vbmeta.img" ]; then
    dd if="$WORKDIR/vbmeta.img" of=/dev/block/bootdevice/by-name/vbmeta bs=4M 2>/dev/null || true
    rm -f "$WORKDIR/vbmeta.img"
fi

# Flashing dynamic partitions
ui_print "- Extracting & Flashing Dynamic Super Partition (may take a few minutes)..."
unzip -o "$ZIPFILE" super.img -d "$WORKDIR" >/dev/null 2>&1 || true
if [ -f "$WORKDIR/super.img" ]; then
    simg2img "$WORKDIR/super.img" /dev/block/bootdevice/by-name/super 2>/dev/null || \
    dd if="$WORKDIR/super.img" of=/dev/block/bootdevice/by-name/super bs=4M
    rm -f "$WORKDIR/super.img"
else
    ui_print "- Flashing individual dynamic partitions..."
    for p in system system_ext product my_product my_stock my_heytap my_carrier my_region my_bigball my_manifest my_company my_preload my_engineering vendor odm; do
        unzip -o "$ZIPFILE" "${p}.img" -d "$WORKDIR" >/dev/null 2>&1 || true
        if [ -f "$WORKDIR/${p}.img" ]; then
            BLOCK_DEV=$(find /dev/block/mapper -name "$p" 2>/dev/null | head -n 1)
            [ -z "$BLOCK_DEV" ] && BLOCK_DEV="/dev/block/by-name/$p"
            if [ -b "$BLOCK_DEV" ]; then
                ui_print "  -> Flashing $p..."
                dd if="$WORKDIR/${p}.img" of="$BLOCK_DEV" bs=4M 2>/dev/null || true
            fi
            rm -f "$WORKDIR/${p}.img"
        fi
    done
fi

rm -rf "$WORKDIR"

# Clean cache & stale runtime configs
ui_print "- Cleaning stale caches and tombstones..."
rm -rf /data/dalvik-cache/* 2>/dev/null || true
rm -rf /data/system/package_cache/* 2>/dev/null || true
rm -rf /data/system/display_settings.xml 2>/dev/null || true
rm -rf /data/tombstones/* 2>/dev/null || true
rm -rf /cache/* 2>/dev/null || true

ui_print " "
ui_print "*****************************************************"
ui_print "*   Installation Complete!                           *"
ui_print "*   Format Data in TWRP/OrangeFox before rebooting!  *"
ui_print "*****************************************************"
exit 0
