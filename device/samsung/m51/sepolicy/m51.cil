; ==============================================================================
; SELinux compatibility rules for Samsung Galaxy M51 (SM7150) on ColorOS
; ==============================================================================

(allow system_server hal_fingerprint_default (binder (call transfer)))
(allow hal_fingerprint_default system_server (binder (call transfer)))
(allow hal_fingerprint_default fingerprintd_data_file (dir (create read write search open getattr add_name remove_name)))
(allow hal_fingerprint_default fingerprintd_data_file (file (create read write getattr setattr open unlink rename)))

(allow system_server hal_sensors_default (binder (call transfer)))
(allow hal_sensors_default system_server (binder (call transfer)))

(allow system_server hal_audio_default (binder (call transfer)))
(allow hal_audio_default system_server (binder (call transfer)))

(allow system_server hal_graphics_allocator_default (binder (call transfer)))
(allow hal_graphics_allocator_default system_server (binder (call transfer)))

(allow system_server hal_graphics_composer_default (binder (call transfer)))
(allow hal_graphics_composer_default system_server (binder (call transfer)))
